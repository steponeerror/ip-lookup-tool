# IP Radar configuration — tracked defaults, safe to commit.
# Real secrets belong in .env.local (gitignored); values there override this file.

# ── Optional intelligence-source API keys (empty = source skipped) ──
# https://ipinfo.io/account/token
IPINFO_TOKEN=
# https://abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# https://otx.alienvault.com/settings
OTX_API_KEY=
IP2PROXY_TOKEN=
# https://ipapi.is/ (paid enrichment; needs IPAPI_IS_ENABLED=true)
IPAPI_IS_KEY=
IPAPI_IS_ENABLED=false

# ── Runtime knobs (defaults live in code; uncomment to override) ──
# IPRADAR_AUTO_REFRESH=1
# IPRADAR_REFRESH_INTERVAL_SEC=1800
# IPRADAR_COLD_START_TIMEOUT=
# TZ: set here or in .env.local — both reach the container
# TZ=UTC
# IPRADAR_PORT: read ONLY from this file (or shell env); .env.local cannot change it
# IPRADAR_PORT=8000
