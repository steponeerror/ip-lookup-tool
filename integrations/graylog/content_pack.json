    {
      "id": "d1b2c3d4-0001-4000-8000-000000000001",
      "type": {
        "name": "pipeline_rule",
        "version": "1"
      },
      "title": "ipradar enrich src_ip",
      "configuration": {
        "source": "rule \"ipradar enrich src_ip\"\nwhen\n    has_field(\"src_ip\")\nthen\n    let verdict    = lookup(\"ipradar-verdict\", to_string($message.src_ip));\n    let confidence = lookup(\"ipradar-confidence\", to_string($message.src_ip));\n    let country    = lookup(\"ipradar-country\", to_string($message.src_ip));\n    set_field(\"ipradar_verdict\", verdict);\n    set_field(\"ipradar_confidence\", to_long(confidence));\n    set_field(\"ipradar_country\", country);\nend"
      }
    },
    {
      "id": "d1b2c3d4-0002-4000-8000-000000000002",
      "type": {
        "name": "pipeline_rule",
        "version": "1"
      },
      "title": "ipradar flag malicious source",
      "configuration": {
        "source": "rule \"ipradar flag malicious source\"\nwhen\n    to_string($message.ipradar_verdict) == \"malicious\"\n    AND to_long($message.ipradar_confidence) >= 70\nthen\n    set_field(\"ipradar_alert\", true);\nend"
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000001",
      "type": {
        "name": "pipeline",
        "version": "1"
      },
      "title": "IP Radar enrichment",
      "configuration": {
        "source": "stage 0: match either\nrule \"ipradar enrich src_ip\"\nrule \"ipradar flag malicious source\"\n",
        "description": "Enrich src_ip-bearing messages with the local IP Radar verdict. Requires IP Radar on http://127.0.0.1:8000 (github.com/steponeerror/ip-radar)."
      },
      "constraints": [
